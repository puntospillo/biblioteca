# Netlify serviva il manifest come application/octet-stream: alcuni browser
# lo scartano e con esso le icone dichiarate lì dentro.
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

# Le icone cambiano di rado ma devono poter essere aggiornate senza attese
# eterne: Safari tiene in cache le favicon molto a lungo.
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon-32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
